# ============================================================
# Matothèque — .env déploiement Proxmox (copier en .env)
# ============================================================
# Ce qui N'EST PLUS ici (par conception) :
#   • Mot de passe DB  → fichier secret ./secrets/db_password.txt (chmod 600)
#   • URL Ollama       → Paramètres → Services & modèles IA (surcharge base)
#   • Dossiers sources → Sources / Connecteurs (SMB, Synology) dans l'UI
# ------------------------------------------------------------

# Identité de la base (doit rester cohérente entre postgres et le backend).
# Le MOT DE PASSE n'est pas ici : il vit dans ./secrets/db_password.txt
DB_USER=docflow
DB_NAME=docflow

# Ports publiés sur la VM
FRONTEND_PORT=3003
BACKEND_PORT=8000

# Version d'image à tirer depuis le registry Gitea (latest ou vX.Y.Z)
DOCFLOW_VERSION=latest

# Origines CORS autorisées (adapter à l'IP/nom d'accès de la VM si besoin)
# CORS_ORIGINS=http://192.168.1.50:3003

# ── Antivirus ClamAV (désactivé par défaut — coûteux en RAM) ──
# Pour l'activer : décommenter la ligne ci-dessous ET démarrer avec
#   docker compose -f docker-compose.proxmox.yml --profile antivirus up -d
# CLAMAV_HOST=clamav
